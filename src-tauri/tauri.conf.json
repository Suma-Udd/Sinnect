{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sinnect",
  "version": "0.2.0",
  "identifier": "dev.sinnect.app",
  "build": {
    "beforeDevCommand": "npm run build -w packages/engine && npm run dev:ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build && node scripts/prepare-engine.mjs",
    "frontendDist": "../packages/ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sinnect",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#161616",
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:*; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Sinnect",
    "category": "DeveloperTool",
    "shortDescription": "A canvas for Claude sessions",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/engine/": "engine/"
    },
    "externalBin": [
      "binaries/node"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "startMenuFolder": "Sinnect"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": {
          "width": 540,
          "height": 380
        },
        "appPosition": {
          "x": 140,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 400,
          "y": 180
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCRjdERkEyMzBFMDY4OUMKUldTY2FPQXdvdC8zSzJPbm41bVdNVlpHOERYOWFSeDc2WlBibGdJa1k0Y0VWblRsTkkzOHFUZHEK",
      "endpoints": [
        "https://github.com/Suma-Udd/Sinnect/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
